local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()
local Window = Rayfield:CreateWindow({
    Name = "GeminiXD | FIX",
    LoadingTitle = "Bypassing...",
    LoadingSubtitle = "2108 Edition",
    ConfigurationSaving = {Enabled = false},
    KeySystem = false
})

local Tab = Window:CreateTab("Combat", 4483362458)
_G.TapToShoot = false

local function superShoot()
    if not _G.TapToShoot then return end
    local lp = game.Players.LocalPlayer
    local char = lp.Character
    local gun = char and char:FindFirstChild("Gun") or lp.Backpack:FindFirstChild("Gun")
    
    if gun and lp.Backpack:FindFirstChild("Gun") then
        lp.Backpack.Gun.Parent = char
    end

    for _, v in pairs(game.Players:GetPlayers()) do
        if v ~= lp and v.Character and (v.Character:FindFirstChild("Knife") or v.Backpack:FindFirstChild("Knife")) then
            local target = v.Character:FindFirstChild("HumanoidRootPart")
            if target then
                char.HumanoidRootPart.CFrame = CFrame.new(char.HumanoidRootPart.Position, Vector3.new(target.Position.X, char.HumanoidRootPart.Position.Y, target.Position.Z))
                local remote = game:GetService("ReplicatedStorage"):FindFirstChild("ShootGun", true) or game:GetService("ReplicatedStorage"):FindFirstChild("GunShot", true)
                if remote then
                    remote:FireServer(target.Position, target)
                end
            end
            break
        end
    end
end

Tab:CreateToggle({
    Name = "Active Tap-to-Shoot",
    CurrentValue = false,
    Flag = "TSSM",
    Callback = function(Value) _G.TapToShoot = Value end,
})

game:GetService("UserInputService").InputBegan:Connect(function(input, processed)
    if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
        pcall(superShoot)
    end
end)
