-- GeminiXD 2108 | MM2 SAFE PRO V3 (AUTO-AIM FIX)
local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()

local Window = Rayfield:CreateWindow({
    Name = "GeminiXD | MM2 Clean Pro",
    LoadingTitle = "Filtering Viruses...",
    LoadingSubtitle = "Year 2108 Security",
    ConfigurationSaving = {Enabled = false},
    KeySystem = false
})

local Tab = Window:CreateTab("Combat", 4483362458)
local lp = game.Players.LocalPlayer
_G.TapToShoot = false -- Default OFF muna

-- 🎯 FIXED SHOOT LOGIC V3
local function shootAtMurderer()
    if not _G.TapToShoot then return end
    
    local char = lp.Character
    local gun = char and char:FindFirstChild("Gun") or lp.Backpack:FindFirstChild("Gun")
    
    if not gun then return end

    for _, v in pairs(game.Players:GetPlayers()) do
        if v ~= lp and v.Character and (v.Character:FindFirstChild("Knife") or v.Backpack:FindFirstChild("Knife")) then
            local targetPart = v.Character:FindFirstChild("HumanoidRootPart")
            if targetPart then
                -- Eto ang lunas: I-force natin yung LookVector ng character
                char.HumanoidRootPart.CFrame = CFrame.new(char.HumanoidRootPart.Position, targetPart.Position)
                
                local rs = game:GetService("ReplicatedStorage")
                local shootRemote = rs:FindFirstChild("ShootGun", true) or rs:FindFirstChild("GunShot", true)
                
                if shootRemote then
                    -- Pinapasa ang Position + Target Instance
                    shootRemote:FireServer(targetPart.Position, targetPart)
                    print("GeminiXD: Murderer Deleted! 🎯")
                end
            end
            break
        end
    end
end

-- UI Toggle
Tab:CreateToggle({
    Name = "Active Tap-to-Shoot",
    CurrentValue = false,
    Flag = "TSSM_SAFE",
    Callback = function(Value)
        _G.TapToShoot = Value
    end,
})

-- Mobile Tap Detection
game:GetService("UserInputService").InputBegan:Connect(function(input, processed)
    if processed then return end
    if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
        pcall(shootAtMurderer)
    end
end)
