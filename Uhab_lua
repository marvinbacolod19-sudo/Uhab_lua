--[[ 
    GeminiXD 2108 | MM2 Ultimate Tap-to-Shoot
    UI: Rayfield (Mobile Optimized)
]]--

local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()

local Window = Rayfield:CreateWindow({
    Name = "GeminiXD | MM2 Pro",
    LoadingTitle = "Directing Tech 2108...",
    LoadingSubtitle = "Admin Edition",
    ConfigurationSaving = {Enabled = false},
    KeySystem = false
})

local Tab = Window:CreateTab("Combat", 4483362458)

local targetMurd = true
local lp = game.Players.LocalPlayer

-- Function para sa Pag-detect at Pag-shoot
local function shootMurderer()
    if not targetMurd then return end
    
    local character = lp.Character
    local gun = character and (character:FindFirstChild("Gun") or lp.Backpack:FindFirstChild("Gun"))
    
    if not gun then return end

    -- Hanapin ang Murderer
    for _, v in pairs(game.Players:GetPlayers()) do
        if v ~= lp and v.Character and (v.Character:FindFirstChild("Knife") or v.Backpack:FindFirstChild("Knife")) then
            local targetHrp = v.Character:FindFirstChild("HumanoidRootPart")
            if targetHrp then
                -- Direct Remote Fire (MM2 2026 Optimized)
                local rs = game:GetService("ReplicatedStorage")
                local shoot = rs:FindFirstChild("ShootGun", true) or rs:FindFirstChild("GunShot", true)
                
                if shoot then
                    shoot:FireServer(targetHrp.Position)
                    print("GeminiXD: Murderer Deleted! 🎯")
                end
            end
            break
        end
    end
end

-- UI Toggle
Tab:CreateToggle({
    Name = "Tap-to-Shoot Murderer",
    CurrentValue = true,
    Flag = "TSSM",
    Callback = function(Value)
        targetMurd = Value
    end,
})

-- Mobile Tap Detection
game:GetService("UserInputService").InputBegan:Connect(function(input, processed)
    if processed then return end
    if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
        pcall(shootMurderer)
    end
end)

Rayfield:Notify({
    Title = "Ready to Go!",
    Content = "Equip Gun and Tap anywhere to Kill Murderer.",
    Duration = 5,
    Image = 4483362458,
})
